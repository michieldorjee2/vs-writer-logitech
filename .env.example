GRAPH_AUTH_KEY=your_optimizely_graph_auth_key_here
GRAPH_SINGLE_KEY=your_optimizely_graph_single_key_here
# Optional: the CMS instance the /preview page loads the editor's script from.
# Defaults to Showcase's (https://app-opti01saas4uc99t001.cms.optimizely.com).
VITE_CMS_URL=
# Sign-in ("Log in with Optimizely" through the Mark Down wiki's relay). The
# relay's secret for app `showcase` — the wiki holds the same value as
# AUTH_RELAY_SECRET_SHOWCASE. Unset = no gate (local dev); see README "Sign-in".
OPTIID_RELAY_SECRET=
# Optional: signs session cookies (defaults to one derived from the relay secret).
SESSION_SECRET=
# Optional: the wiki running the relay (defaults to https://md.optimizely.com).
WIKI_URL=
# Local dev only: who the dev server and an ungated function treat as signed in.
DEV_AUTH_EMAIL=
# aldus-ui (Limitless) for /search: its running offers, their looks, and who
# gets the links back to it. ALDUS_SHOWCASE_TOKEN is aldus-ui's
# SHOWCASE_MACHINE_TOKEN. Unset = no offers and no links; see README "Sign-in".
ALDUS_UI_URL=
ALDUS_SHOWCASE_TOKEN=
# The email sign-up form on offer pages (README "Offer pages: the email sign-up
# form"): exactly "on" turns it on. Set it with aldus-ui's OFFER_SIGNUP_FORM=on,
# which shows the offer screen's Sign-ups panel. Unset = every page links out.
OFFER_SIGNUP_FORM=
# Optional: comma-separated https URLs that also get every sign-up (a Google
# Sheet's web app, later the ODP and Marketo form proxy). Unset = none.
OFFER_SIGNUP_WEBHOOKS=
# The one-click ask (README "The one-click ask"): Mark's "Showcase CTA ping"
# webhook and its x-showcase-key. Production only; unset = the click messages
# nobody (previews and local runs). Both are credentials: never commit them.
CTA_PING_WEBHOOK_URL=
CTA_PING_WEBHOOK_KEY=
# The booth's Report (README "The booth rail and the Report"): the ODP account's private API key, read only by
# api/_lib/odp-events.ts. Unset = the report answers 503; pages still record visits.
ODP_PRIVATE_KEY=
# Personal links (README "Sharing a page: personal links"): Send to me posts to Mark's
# "Showcase share to Teams" webhook with its x-showcase-key. Unset = Send to me answers 503.
# Credentials: never commit them.
SHARE_TEAMS_WEBHOOK_URL=
SHARE_TEAMS_WEBHOOK_KEY=
# Optional: another email-writing agent than showcase_share_email (needs OPAL_PAT).
SHARE_EMAIL_AGENT_ID=
# Badge scanning on /search: the browser reads badges itself. Optional: Mark's
# badge-reader agent id (needs OPAL_PAT) for the badges the browser can't read.
MARK_BADGE_AGENT_ID=
# Local preview only: Mark's badge reads answered without Mark. Refused whenever
# VERCEL_ENV or NODE_ENV is production.
BADGE_READ_STUB=
# Teams photos on pages (README "Teams photos on pages"): exactly "on" lets a colleague's Microsoft Teams photo
# stand in for a missing Gravatar on account, person and offer pages and in the search page's corner. Set it
# with aldus-ui's PAGE_PEOPLE_PHOTOS=on (offer hosts' photos come through it). Unset = every card is as it was.
# It needs nothing else: the wiki is asked with OPTIID_RELAY_SECRET above, Limitless with ALDUS_UI_URL and
# ALDUS_SHOWCASE_TOKEN above.
PAGE_PEOPLE_PHOTOS=
