{
  "functions": {
    "api/ssr.ts": {
      "includeFiles": "api/_ssr-bundle.mjs"
    }
  },
  "headers": [
    {
      "source": "/((?!api/).*)",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/logos/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400, stale-while-revalidate=604800" }
      ]
    },
    {
      "source": "/opensearch.xml",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400" }
      ]
    },
    {
      "source": "/robots.txt",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=3600, stale-while-revalidate=86400" }
      ]
    },
    {
      "source": "/optimizely-logo.svg",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400, stale-while-revalidate=604800" }
      ]
    }
  ],
  "redirects": [
    { "source": "/en/:path*", "destination": "/:path*", "permanent": true }
  ],
  "rewrites": [
    { "source": "/", "destination": "/index.html" },
    { "source": "/preview", "destination": "/index.html" },
    { "source": "/assets/:path*", "destination": "/assets/:path*" },
    { "source": "/opensearch.xml", "destination": "/opensearch.xml" },
    { "source": "/((?!api/|_vercel/).*)", "destination": "/api/ssr" }
  ]
}
